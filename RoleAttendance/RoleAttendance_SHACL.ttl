@prefix ceds: <https://w3id.org/CEDStandards/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ceds:RoleAttendanceShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:NumberOfDaysAbsentShape,
        ceds:NumberOfDaysInAttendanceShape,
        ceds:NumberofDaysTardyShape,
        ceds:RecordEndDateTimeShape,
        ceds:RecordStartDateTimeShape,
        ceds:StudentAttendanceRateShape,
        ceds:hasChronicStudentAbsenteeismIndicatorShape,
        ceds:hasMembershipShape ;
    sh:targetClass ceds:C200350 .

ceds:hasMembershipShape a sh:PropertyShape ;
    sh:class ceds:C200257 ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:P600514 .

