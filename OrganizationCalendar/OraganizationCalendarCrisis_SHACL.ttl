@prefix ceds: <http://ceds.ed.gov/terms#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Create new PersonCrisisShape or rename this to CrisisShape 
ceds:CrisisShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:CrisisCodeShape,
        ceds:CrisisDescriptionShape,
        ceds:CrisisEndDateShape,
        ceds:CrisisNameShape,
        ceds:CrisisStartDateShape,
        ceds:CrisisTypeShape,
        ceds:RecordEndDateTimeShape,
        ceds:RecordStartDateTimeShape,
        ceds:hasOrganizationShape ;
        ceds:hasFacilityShape ;
        ceds:hasOrganizationCalendarShape ; # Add to Ontology and Filter In
        ceds:hasPersonShape ; # Add to Ontology and Filter In
    sh:xone ( ceds:hasOrganizationShape ceds:hasOrganizationCalendarShape ceds:hasPersonShape ) ;
    sh:targetClass ceds:C200242 .

ceds:hasOrganizationShape a sh:PropertyShape ;
    sh:class ceds:C200239 ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:P600062 .

# Add to Ontology
ceds:hasPersonShape a sh:PropertyShape ;
    sh:class ceds:C200275 ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:P600510 .

# Add to Ontology
ceds:hasOrganizationCalendarShape a sh:PropertyShape ;
    sh:class ceds:C200241 ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:P600473 .

# Add to Ontology
ceds:hasFacilityShape a sh:PropertyShape ;
    sh:class ceds:??? ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:??? .