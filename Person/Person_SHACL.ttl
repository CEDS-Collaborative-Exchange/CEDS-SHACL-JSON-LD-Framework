@prefix ceds: <http://ceds.ed.gov/terms#> .
@prefix cepi: <http://cepi-dev.state.mi.us/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ceds:PersonShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ceds:id ) ;
    sh:property ceds:RecordEndDateTimeShape,
        ceds:RecordStartDateTimeShape,
        ceds:hasPersonBirthShape,
        ceds:hasPersonDemographicRaceShape,
        ceds:hasPersonIdentificationShape,
        ceds:hasPersonNameShape,
        ceds:hasPersonSexGenderShape,
        ceds:hasDataCollectionShape ;
    sh:targetClass ceds:C200275 .

ceds:CommittedByOrganizationShape a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:P200999 .

ceds:PersonBirthShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ceds:id ) ;
    sh:property ceds:BirthdateShape,
        ceds:RecordStartDateTimeShape ;
    sh:targetClass ceds:C200376 .

ceds:PersonDemographicRaceShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ceds:id ) ;
    sh:property ceds:RecordEndDateTimeShape,
        ceds:RecordStartDateTimeShape,
        ceds:hasHispanicOrLatinoEthnicityShape,
        ceds:hasRaceAndEthnicityShape,
        ceds:hasRecordStatusShape ;
    sh:targetClass ceds:C200282 .

ceds:PersonIdentificationShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ceds:id ) ;
    sh:property ceds:PersonIdentifierShape,
        ceds:RecordEndDateTimeShape,
        ceds:RecordStartDateTimeShape,
        ceds:hasPersonIdentificationSystemShape,
        ceds:hasPersonIdentifierTypeShape,
        ceds:hasRecordStatusShape ;
    sh:targetClass ceds:C200291 .

ceds:PersonNameShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ceds:id ) ;
    sh:property ceds:FirstNameShape,
        ceds:GenerationCodeOrSuffixShape,
        ceds:LastOrSurnameShape,
        ceds:MiddleNameShape,
        ceds:RecordStartDateTimeShape ;
    sh:targetClass ceds:C200377 .

ceds:PersonSexGenderShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ceds:id ) ;
    sh:property ceds:RecordEndDateTimeShape,
        ceds:RecordStartDateTimeShape,
        ceds:hasSexShape ;
    sh:targetClass ceds:C200011 .

ceds:RecordStatusShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ceds:id ) ;
    sh:property ceds:CommittedByOrganizationShape,
        ceds:RecordEndDateTimeShape,
        ceds:RecordStartDateTimeShape ;
    sh:targetClass ceds:C200411 .

ceds:hasPersonBirthShape a sh:PropertyShape ;
    sh:class ceds:C200376 ;
    sh:node ceds:PersonBirthShape ;
    sh:path ceds:P600335 .

ceds:hasPersonDemographicRaceShape a sh:PropertyShape ;
    sh:class ceds:C200282 ;
    sh:node ceds:PersonDemographicRaceShape ;
    sh:path ceds:P600035 .

ceds:hasPersonIdentificationShape a sh:PropertyShape ;
    sh:class ceds:C200291 ;
    sh:node ceds:PersonIdentificationShape ;
    sh:path ceds:P600049 .

ceds:hasPersonIdentificationSystemShape sh:in (
    ceds:NI001571173116    # CanadianSIN - Canadian Social Insurance Number
    ceds:NI001571173117    # District - District-assigned number
    ceds:NI001571173118    # DriversLicense - Driver's license number
    ceds:NI001571173119    # Federal - Federal identification number
    ceds:NI001571173120    # HealthRecord - Health record number
    ceds:NI001571173121    # Institution - Institution-assigned number
    ceds:NI001571173122    # Medicaid - Medicaid number
    ceds:NI001571173123    # Other - Other    
    ceds:NI001571173124    # OtherFederal - Other federally assigned number    
    ceds:NI001571173125    # PIN - Personal identification number
    ceds:NI001571173126    # ProfessionalCertificate - Professional certificate or license number
    ceds:NI001571173127    # School - School-assigned number
    ceds:NI001571173128    # SelectiveService - Selective Service Number
    ceds:NI001571173129    # SSN - Social Security Administration number
    ceds:NI001571173130    # State - State-assigned number
    ceds:NI001571173131    # USVisa - US government Visa number
    ceds:NI001571173132    # BirthCertificate - Birth certificate number
    ceds:NI001571173133    # Family - Family unit number
    ceds:NI001571173134    # NationalMigrant - National Migrant number
    ceds:NI001571173135    # StateMigrant - State migrant number
    ceds:NI001571173136    # Program - Program-assigned number
    cepi:NI001571100001    # EducatorID - MOECS generated system key for a unique educator
  ) 
  .

ceds:hasPersonNameShape a sh:PropertyShape ;
    sh:class ceds:C200377 ;
    sh:node ceds:PersonNameShape ;
    sh:path ceds:P600336 .

ceds:hasPersonSexGenderShape a sh:PropertyShape ;
    sh:class ceds:C200011 ;
    sh:node ceds:PersonSexGenderShape ;
    sh:path ceds:P600338 .

ceds:hasRecordStatusShape a sh:PropertyShape ;
    sh:class ceds:C200411 ;
    sh:node ceds:RecordStatusShape ;
    sh:path ceds:P201001 .

ceds:hasDataCollectionShape a sh:PropertyShape ;
    sh:class ceds:C200410 ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:P201003 .
